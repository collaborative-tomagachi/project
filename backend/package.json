{
  "name": "collaborative-tomagachi-backend",
  "version": "1.0.0",
  "scripts": {
    "build": "npm run lint && tsc --project tsconfig.prod.json",
    "clean-install": "npm i rimraf && rimraf ./node_modules package-lock.json && npm i",
    "dev": "DOTENV_CONFIG_PATH=./config/.env.development ts-node ./src/main",
    "dev:watch": "nodemon --exec \"npm run dev\" --watch ./src --ext .ts",
    "lint": "eslint .",
    "fmt": "oxfmt \"*.ts\" \"*.js\" \"*.json\"",
    "fmt:check": "oxfmt --check \"*.ts\" \"*.js\" \"*.json\" --ignore-path=node_modules",
    "start": "DOTENV_CONFIG_PATH=./config/.env.production node -r dotenv/config -r module-alias/register ./dist/main.js",
    "test": "NODE_ENV=test vitest",
    "type-check": "tsc -b --noEmit"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.20",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonfile": "^6.2.0",
    "module-alias": "^2.3.4",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@swc/core": "^1.15.18",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/body-parser": "^1.19.6",
    "@types/connect": "^3.4.38",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/find": "^0.2.4",
    "@types/fs-extra": "^11.0.4",
    "@types/http-errors": "^2.0.5",
    "@types/jsonfile": "^6.1.4",
    "@types/module-alias": "^2.0.4",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.1",
    "@types/qs": "^6.15.0",
    "@types/range-parser": "^1.2.7",
    "@types/send": "^1.2.1",
    "@types/serve-static": "^2.2.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.24.0",
    "find": "^0.3.0",
    "fs-extra": "^11.3.4",
    "jiti": "^2.6.1",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.36.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "_moduleAliases": {
    "@src": "dist"
  }
}
